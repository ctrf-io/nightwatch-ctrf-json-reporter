{
	"name": "nightwatch-ctrf-json-reporter",
	"version": "0.2.1",
	"description": "Create a common JSON test report for Nightwatch tests",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		}
	},
	"scripts": {
		"build": "tsup && node scripts/write-cjs-shims.mjs",
		"build:check": "tsc -p . --noEmit",
		"build:watch": "tsup --watch",
		"clean": "rm -rf dist && rm -rf coverage && rm -rf ctrf",
		"test": "npm run build && vitest run",
		"test:watch": "vitest",
		"test:coverage": "npm run build && vitest run --coverage",
		"lint": "biome lint --write . --unsafe",
		"lint:check": "biome lint .",
		"format": "biome format --write .",
		"format:check": "biome format .",
		"all": "npm run build:check && npm run lint:check && npm run format:check && npm run test:coverage && npm run build",
		"check": "biome check .",
		"test:standard:checker": "node tests/standard/checker/run.mjs",
		"test:standard:conformance:unit": "npm run build && node tests/standard/conformance/run.mjs unit",
		"test:standard:conformance:integration": "npm run build && node tests/standard/conformance/run.mjs integration",
		"test:standard:conformance": "node tests/standard/conformance/run-all.mjs",
		"test:standard": "node tests/standard/run-all.mjs"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/ctrf-io/nightwatch-ctrf-json-reporter.git"
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"homepage": "https://ctrf.io",
	"files": [
		"dist/",
		"README.md"
	],
	"author": "Matthew Poulton-White",
	"license": "MIT",
	"keywords": [
		"ctrf",
		"common-test-report-format",
		"test-reporting",
		"test-results",
		"testing",
		"json",
		"ci",
		"nightwatch",
		"nightwatch-reporter"
	],
	"security": {
		"email": "security@ctrf.io",
		"url": "https://github.com/ctrf-io/.github/blob/main/SECURITY.md"
	},
	"devDependencies": {
		"@biomejs/biome": "2.6.3",
		"@d2t/vitest-ctrf-json-reporter": "1.3.0",
		"@types/nightwatch": "3.0.1",
		"@types/node": "26.6.5",
		"@vitest/coverage-v8": "5.0.5",
		"tsup": "9.0.0",
		"typescript": "npm:@typescript/typescript6@6.0.2",
		"vitest": "5.0.5",
		"@typescript/native": "npm:typescript@7.0.2",
		"nightwatch": "3.16.0",
		"ajv": "8.20.0",
		"ajv-formats": "3.0.1"
	},
	"dependencies": {
		"ctrf": "0.5.0"
	},
	"overrides": {
		"serialize-javascript": "7.1.4",
		"uuid": "14.0.3",
		"esbuild": "0.28.2"
	}
}
